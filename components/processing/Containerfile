ARG PROCESSING_BUILD_DEPS_IMAGE=ghcr.io/nlsfi/pinta/processing-build-deps:latest

# Lastools source: lastools-online or lastools-local
# With local put lastools to external/LAStools/LAStools.tar.gz
ARG LASTOOLS_SOURCE=lastools-online
FROM ${PROCESSING_BUILD_DEPS_IMAGE} AS processing-build-deps

FROM redhat/ubi10:10.1 AS base

ARG LASTOOLS_SOURCE
RUN case "${LASTOOLS_SOURCE}" in \
      lastools-online|lastools-local) ;; \
      *) echo "Invalid LASTOOLS_SOURCE: ${LASTOOLS_SOURCE}. Expected one of: lastools-online, lastools-local"; exit 1 ;; \
    esac

# Proxy args
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

ENV HTTP_PROXY=$HTTP_PROXY
ENV HTTPS_PROXY=$HTTPS_PROXY
ENV NO_PROXY=$NO_PROXY

ARG ENABLE_REPOS="*"
ARG DISABLE_REPOS=""
ARG ADDITIONAL_REPO_CONTENTS=""

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# hadolint ignore=DL3041, SC3009
RUN if [ -n "$ADDITIONAL_REPO_CONTENTS" ]; then \
      echo "$ADDITIONAL_REPO_CONTENTS" > /etc/yum.repos.d/extra.repo; \
  fi && \
  dnf update \
    -y \
    --disablerepo="${DISABLE_REPOS}" \
    --enablerepo="${ENABLE_REPOS}" \
  && dnf \
      --disableplugin=subscription-manager \
      --disablerepo="${DISABLE_REPOS}" \
      --enablerepo="${ENABLE_REPOS}" \
      --allowerasing \
      install -y python3.12 python3.12-pip \
      # LASTools dependencies
      libpng libjpeg-turbo \
      # proj dependencies
      sqlite sqlite-devel curl libcurl libcurl-devel \
  && dnf --disableplugin=subscription-manager clean all \
  && ln -s /usr/bin/python3.12 /usr/bin/python \
  && mv /usr/bin/python3{,9} \
  && ln -s /usr/bin/python3.12 /usr/bin/python3

COPY --from=processing-build-deps /usr/local/lib64/ /usr/local/lib64/
COPY --from=processing-build-deps /usr/local/lib/ /usr/local/lib/
COPY --from=processing-build-deps /usr/local/include/nlohmann/json.hpp /usr/local/include/nlohmann/

# Update paths to include the newly added libraries and headers
RUN echo "/usr/local/lib64" > /etc/ld.so.conf.d/proj.conf && \
  echo "/usr/local/lib" > /etc/ld.so.conf.d/local.conf && ldconfig

# Use separate stages to verify LASTools dependecies using
# downloaded binaries or local copied files

FROM base AS lastools-online

# hadolint ignore=DL4006
RUN tmp_dir="$(mktemp -d)" \
  && curl -fsSL --retry 5 --retry-delay 15 --retry-all-errors https://raw.githubusercontent.com/LAStools/LAStools.github.io/5bfd81f57975b312b893135f613417acbc698cbe/download/LAStools.tar.gz -o "${tmp_dir}/lastools.tar.gz" \
  && tar -xzf "${tmp_dir}/lastools.tar.gz" -C "${tmp_dir}" \
  && blast2dem="$(find "${tmp_dir}" -path "*/bin/blast2dem64" -type f | head -n 1)" \
  && test -n "${blast2dem}" \
  && if ldd "${blast2dem}" | grep "not found"; then \
      echo "Missing dependencies for LASTools!"; \
      exit 1; \
    fi \
  && echo "All LASTools dependencies are installed." \
  && rm -rf "${tmp_dir}"


FROM base AS lastools-local

COPY external/LAStools/LAStools.tar.gz /tmp/local-LAStools.tar.gz

# hadolint ignore=DL4006
RUN tmp_dir="$(mktemp -d)" \
  && test -s /tmp/local-LAStools.tar.gz || { echo "Missing local LAStools tarball at external/LAStools/LAStools.tar.gz"; exit 1; } \
  && tar -xzf /tmp/local-LAStools.tar.gz -C "${tmp_dir}" \
  && blast2dem="$(find "${tmp_dir}" -path "*/bin/blast2dem64" -type f | head -n 1)" \
  && test -n "${blast2dem}" \
  && if ldd "${blast2dem}" | grep "not found"; then \
      echo "Missing dependencies for LASTools!"; \
      exit 1; \
    fi \
  && echo "All LASTools dependencies are installed." \
  && rm -rf "${tmp_dir}" /tmp/local-LAStools.tar.gz


# Run LASTools dependecy check based on LASTOOLS_SOURCE build arg
FROM ${LASTOOLS_SOURCE} AS final

# hadolint ignore=DL3013
RUN python -m pip install --upgrade pip --no-cache-dir \
  && pip install uv --no-cache-dir

WORKDIR /code

COPY components/processing/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

COPY pyproject.toml uv.lock ./
COPY components ./components

RUN uv venv /venv
ENV VIRTUAL_ENV=/venv
ENV PATH="/venv/bin:$PATH"
WORKDIR /code/components/processing
RUN uv sync --no-dev --active --no-install-project && uv pip install -e .

ENTRYPOINT ["/entrypoint.sh"]
