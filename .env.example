# Docker compose variables
# ========================
COMPOSE_DB_PORT=5400

# Set this to absolute path to your repository
# in host to be able to mount volumes in devcontainer.
# In WSL it is under /mnt/c/... if the repo is cloned on Windows host.
REPO_DIR=

# Primary database variables
# ========================
DB_PRIMARY_ADMIN_USER=admin
DB_PRIMARY_ADMIN_PASSWORD=admin
DB_PRIMARY_HOST=localhost
DB_PRIMARY_PORT=5400

# -- Hardcoded values, do not modify in .env file in development!
DB_PRIMARY_NAME=pinta

DB_PRIMARY_OWNER_ROLE=pinta_owner
DB_PRIMARY_WRITER_ROLE=pinta_writer
DB_PRIMARY_READER_ROLE=pinta_reader
DB_PRIMARY_PROCESSING_WORKER_ROLE=pinta_processing_worker

DB_PRIMARY_EDITOR_USER=qgis_editor
DB_PRIMARY_VIEWER_USER=qgis_viewer
DB_PRIMARY_EDITOR_PASSWORD=qgis
DB_PRIMARY_VIEWER_PASSWORD=qgis

DB_PRIMARY_PROCESSING_WORKER_USER=processing_worker
DB_PRIMARY_PROCESSING_WORKER_PASSWORD=processing_worker
# -- End of hardcoded values

DB_SRID=3067

DB_DEM_PIXEL_SIZE=2
DB_DEM_NODATA=-9999

# Job database variables
# ========================
DB_JOB_ADMIN_USER=admin
DB_JOB_ADMIN_PASSWORD=admin
DB_JOB_HOST=localhost
DB_JOB_PORT=5400

# -- Hardcoded values, do not modify in .env file in development!
DB_JOB_NAME=pinta
DB_JOB_TEMPLATE_NAME=job_template

DB_JOB_OWNER_ROLE=pinta_owner
DB_JOB_WRITER_ROLE=pinta_writer
DB_JOB_READER_ROLE=pinta_reader
DB_JOB_PROCESSING_WORKER_ROLE=pinta_processing_worker

DB_JOB_EDITOR_USER=qgis_editor
DB_JOB_VIEWER_USER=qgis_viewer
DB_JOB_EDITOR_PASSWORD=qgis
DB_JOB_VIEWER_PASSWORD=qgis

DB_JOB_PROCESSING_WORKER_USER=processing_worker
DB_JOB_PROCESSING_WORKER_PASSWORD=processing_worker
# -- End of hardcoded values

# Plugin variables
# ========================
# -- qgis-plugin-dev-tools --
QGIS_EXECUTABLE_PATH=/usr/bin/qgis # path to qgis-bin/qgis-bin-ltr
# DEBUGGER_LIBRARY= # debugpy/pydevd to start a debugger on init, library must be installed to the environment
# DEVELOPMENT_PROFILE_NAME= # name of the profile that qgis is launched with, otherwise uses defaul

# -- QGIS environment variabled --
# QGIS_LOCALE=fi
QGIS_GLOBAL_SETTINGS_FILE=components/qgis_plugin/settings.ini


# -- Pinta variables --
# Path to a custom background layer config.
#  See default one here: components/qgis_plugin/src/pinta_qgis_plugin/resources/layer_config/background_layer_config.json
# PINTA_BASE_MAP_LAYER_CONFIG=

# Initial project extent rectangle provided in DB_SRID crs
PINTA_INITIAL_PROJECT_EXTENT=-67734,6570084,843161,7879314

PINTA_DEVELOPMENT_MODE=true

PINTA_BACKEND_PORT=3011
PINTA_BACKEND_AIRFLOW_BASE_URL=http://localhost:8080
# Populate this to .env with make backend-setup-password
PINTA_BACKEND_AIRFLOW_USERNAME=
