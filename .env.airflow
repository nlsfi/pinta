# Airflow static variables that are the same in container and local airflow

# Airflow variables
AIRFLOW__API__HOST=0.0.0.0
AIRFLOW__CORE__LOAD_EXAMPLES=false

AIRFLOW__API__PORT=8080
AIRFLOW__API__EXPOSE_CONFIG=true
AIRFLOW__DAG_PROCESSOR__REFRESH_INTERVAL=5

# Airflow pinta variables
AIRFLOW_VAR_PINTA_PROCESSING_TASK_LOG_LEVEL=DEBUG
AIRFLOW_VAR_PINTA_PROCESSING_IMAGE=ghcr.io/nlsfi/pinta/processing:latest
AIRFLOW_VAR_PINTA_DOCKER_SOCKET_URL=unix:///var/run/docker.sock
AIRFLOW_VAR_PINTA_CONTAINER_TARGET_BASE_PATH=/data
AIRFLOW_VAR_PINTA_DB_SRID=3067
AIRFLOW_VAR_PINTA_DB_DEM_PIXEL_SIZE=2
AIRFLOW_VAR_PINTA_DB_DEM_NODATA=-9999
